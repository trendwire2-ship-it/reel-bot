 "scenes": [
  {
   "say": "A wave of molasses killed 21 people in Boston.",
   "hook": "KILLED BY MOLASSES"
  },
  {
   "say": "January 15, 1919. An unusually warm winter day in Boston's North End. Around lunchtime, people heard a deep rumble."
  },
  {
   "say": "A steel tank, 50 feet tall and holding over 2 million gallons of molasses, burst apart.",
   "hook": "2 MILLION GALLONS"
  },
  {
   "say": "A brown wall of syrup, about 15 feet high, roared through the streets at 35 miles per hour."
  },
  {
   "say": "It snapped the steel supports of an elevated railway. It knocked a firehouse right off its foundation."
  },
  {
   "say": "21 people died. About 150 were injured. But the strangest part came before the wave.",
   "hook": "THE WARNING SIGNS"
  },
  {
   "say": "The tank had leaked for years. Local children collected the dripping molasses in pails."
  },
  {
   "say": "The owners reportedly painted the tank brown to hide the leaks. After the disaster, they blamed anarchists and a bomb.",
   "hook": "THEY BLAMED A BOMB"
  },
  {
   "say": "In 1925, a court-appointed auditor ruled otherwise. The owners' negligence was to blame.",
   "hook": "THE VERDICT"
  },
  {
   "say": "States adopted stricter building codes. And Boston smelled of molasses for years afterward."
  },
  {
   "say": "Freak accident, or corporate greed? Tell me in the comments."
  }
 ],
