 "scenes": [
  {
   "say": "7:25 PM, May 6, 1937. An airship 804 feet long is landing in New Jersey. Seconds later, it's on fire.",
   "hook": "THE SKY CAUGHT FIRE"
  },
  {
   "say": "The Hindenburg. 97 people aboard, three days out from Frankfurt, Germany."
  },
  {
   "say": "Thunderstorms had delayed the landing for hours. The captain circled the Jersey shore, waiting for clear skies."
  },
  {
   "say": "Its giant gas cells were filled with hydrogen. One spark, and it burns.",
   "hook": "THE DEADLY SECRET"
  },
  {
   "say": "On the ground, radio reporter Herbert Morrison was recording. Then he shouted, 'It burst into flames!'",
   "hook": "THEN HE SAID THIS..."
  },
  {
   "say": "Fire raced along the ship. In just over 30 seconds, it crashed to the ground."
  },
  {
   "say": "Morrison kept recording, his voice breaking. 'Oh, the humanity, and all the passengers screaming around here!'"
  },
  {
   "say": "Passengers jumped from the windows as it fell. Incredibly, 62 people survived. 36 died.",
   "hook": "62 SURVIVED"
  },
  {
   "say": "The likely cause? A static spark igniting leaking hydrogen. Sabotage was never proven."
  },
  {
   "say": "The disaster ended the age of passenger airships almost overnight. And the whole thing was caught on film."
  },
  {
   "say": "Was it an accident, or something more? Tell me in the comments."
  }
 ],
