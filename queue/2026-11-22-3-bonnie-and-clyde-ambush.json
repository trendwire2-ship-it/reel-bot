 "scenes": [
  {
   "say": "May 23, 1934. A Louisiana back road. Six lawmen hide in the bushes, waiting for America's most wanted couple.",
   "hook": "THE TRAP IS SET"
  },
  {
   "say": "Bonnie Parker and Clyde Barrow. Police believed they had committed 13 murders."
  },
  {
   "say": "She stood 5 foot 5, just 100 pounds. He drove a Ford V8 at up to 90 miles an hour."
  },
  {
   "say": "In January 1934, they raided Eastham prison farm in Texas and broke out five prisoners.",
   "hook": "THE BREAKOUT"
  },
  {
   "say": "One of them was Henry Methvin. His family would hold the key to the trap."
  },
  {
   "say": "Henry's father parked his truck by the road with a wheel off, like a flat tire.",
   "hook": "THE BAIT"
  },
  {
   "say": "Then a Ford V8 came down the road. It slowed beside the truck. That was the signal."
  },
  {
   "say": "The lawmen opened fire. More than 100 rounds tore into the car. Both were killed instantly.",
   "hook": "100+ ROUNDS"
  },
  {
   "say": "Within hours, the nearby town of Gibsland swelled from 2,000 people to 12,000."
  },
  {
   "say": "Today, their bullet-riddled car sits on display at a Nevada casino.",
   "hook": "WHERE IT IS NOW"
  },
  {
   "say": "Ruthless killers, or outlaws the newspapers turned into legends? Tell me in the comments."
  }
 ],
